  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur5_workcell_description</exec_depend>
  <exec_depend>ur5_workcell_moveit_config</exec_depend>
