<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="xela_usp44" params="parent prefix:='' *origin">
    <link name="${prefix}tactile_sensor">
      <visual>
        <geometry><box size="0.0246 0.0246 0.006"/></geometry>
        <material name="XELA-Blue"><color rgba="0 0 1 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.0246 0.0246 0.006"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}tactile_sensor_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}tactile_sensor"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>
</robot>
