<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="realsense_l515" params="parent prefix:='' *origin">
    <link name="${prefix}camera_link">
      <visual>
        <!-- Pinned RealSense 4.54.1 _l515.urdf.xacro: front-plate mesh to body frame. -->
        <origin xyz="0.0045 0 0.009" rpy="${pi/2} 0 ${pi/2}"/>
        <geometry>
          <mesh filename="package://realsense_l515_description/meshes/l515.dae"/>
        </geometry>
      </visual>
      <!-- Conservative bounds migrated from the legacy collision model. -->
      <collision>
        <origin xyz="-0.006456 0 0.009" rpy="${pi/2} 0 ${pi/2}"/>
        <geometry>
          <box size="0.08184 0.08184 0.046728"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.006456 0 0.009" rpy="${pi/2} 0 ${pi/2}"/>
        <mass value="0.3"/>
        <inertia ixx="0.0001027" ixy="0" ixz="0"
                 iyy="0.0001027" iyz="0" izz="0.0001442"/>
      </inertial>
    </link>

    <joint name="${prefix}camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}camera_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>
</robot>
