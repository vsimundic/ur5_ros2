<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5_robotiq">
    <xacro:arg name="name" default="ur" />
    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />
    <xacro:include
        filename="$(find robotiq_description)/urdf/robotiq_3f_gripper_articulated_macro_fixed.xacro" />
    <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro" />

    <!-- <xacro:include filename="$(find robotiq_description)/urdf/robotiq-ft300.urdf.xacro" /> -->
    <!-- <xacro:include filename="$(find robotiq_description)/urdf/robotiq-fts.ros2_control.xacro"
    /> -->

    <!-- possible 'ur_type' values: ur3, ur5, ur10, ur3e, ur5e, ur7e, ur10e, ur12e, ur16e, ur8long,
    ur15, ur20,
    ur30 --> <!-- the
    default value should raise an error in case this was called without defining the type -->
    <xacro:arg name="ur_type" default="ur5" />
    <xacro:arg name="tf_prefix" default="" />
    <xacro:arg name="rq_prefix" default="rq_" />
    <xacro:arg name="ft_prefix" default="" />
    <xacro:arg name="joint_limit_params"
        default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml" />
    <xacro:arg name="kinematics_params"
        default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml" />
    <xacro:arg name="physical_params"
        default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml" />
    <xacro:arg name="visual_params"
        default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml" />
    <xacro:arg name="transmission_hw_interface" default="" />
    <xacro:arg name="safety_limits" default="false" />
    <xacro:arg name="safety_pos_margin" default="0.15" />
    <xacro:arg name="safety_k_position" default="20" />
    <xacro:arg name="simulation_controllers"
        default="$(find ur5_robotiq_moveit_config)/config/ros2_controllers.yaml" />
    <xacro:arg name="ros_namespace" default="" />

    <link name="world" /> <!-- world frame -->
    <link name="robot_mount" /> <!-- robot base mount -->

    <!-- Table -->
    <link name="table">
        <visual>
            <origin xyz="0 0 0.4" rpy="0 0 0" />
            <geometry>
                <box size="1.0 2.0 0.8" />
            </geometry>
            <material name="brown">
                <color rgba="0.4 0.25 0.1 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.4" rpy="0 0 0" />
            <geometry>
                <box size="1.0 2.0 0.8" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.4" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia
                ixx="0.38666666666" ixy="0.0" ixz="0.0" iyy="0.13666666666" iyz="0.0"
                izz="0.41666666666" />
        </inertial>
    </link>

    <!-- Fix table to world frame -->
    <joint name="joint_world_table" type="fixed">
        <parent link="world" />
        <child link="table" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Fix the robot base to the table -->
    <joint name="joint_table_robot_mount" type="fixed">
        <parent link="table" />
        <child link="robot_mount" />
        <origin xyz="0 ${-(2.0/2 - 0.3)} 0.8" rpy="0 0 0" />
    </joint>


    <!-- Wall to the right of the robot -->
    <link name="wall">
        <visual>
            <origin xyz="0 0 1.0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 1.0 2.0" />
            </geometry>
            <material name="light_gray">
                <color rgba="0.7 0.7 0.7 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 1.0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 1.0 2.0" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 1.0" rpy="0 0 0" />
            <mass value="5.0" />
            <inertia ixx="0.2" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.01" />
        </inertial>
    </link>

    <joint name="joint_table_wall" type="fixed">
        <parent link="table" />
        <child link="wall" />
        <origin xyz="${0.5+0.05/2} ${-(2.0/2 - 0.3)} 0.0" rpy="0 0 0" />
    </joint>


    <!-- arm -->
    <xacro:ur_robot
        name="$(arg name)"
        tf_prefix="$(arg tf_prefix)"
        parent="robot_mount"
        joint_limits_parameters_file="$(arg joint_limit_params)"
        kinematics_parameters_file="$(arg kinematics_params)"
        physical_parameters_file="$(arg physical_params)"
        visual_parameters_file="$(arg visual_params)" safety_limits="$(arg safety_limits)"
        safety_pos_margin="$(arg safety_pos_margin)" safety_k_position="$(arg safety_k_position)"
        force_abs_paths="true">
        <origin xyz="0 0 0" rpy="0 0 0" /> <!-- position robot in the robot_mount -->
    </xacro:ur_robot>

    <!-- Robotiq gripper -->
    <xacro:robotiq_3f_gripper_articulated prefix="$(arg rq_prefix)" />

    <!-- FT300 sensor -->
    <!-- Attach ft sensor to tool0 -->
    <!-- <xacro:robotiq_ft300 parent="tool0" tf_prefix="$(arg ft_prefix)">
        <origin xyz="0 0 -0.004" rpy="0 0 0"/> 
    </xacro:robotiq_ft300> -->

    <!-- Attach gripper to ft sensor -->
    <!-- <joint name="tool0_$(arg rq_prefix)palm_joint" type="fixed">
        <parent link="$(arg ft_prefix)robotiq_ft_frame_id" />
        <child link="$(arg rq_prefix)palm" />
        <origin xyz="0 0 0.0535" rpy="${-pi/2} ${-pi} ${-pi/4}" />
    </joint> -->

    <joint name="tool0_$(arg rq_prefix)palm_joint" type="fixed">
        <parent link="tool0" />
        <child link="$(arg rq_prefix)palm" />
        <origin xyz="0 0 0.0535" rpy="${-pi/2} ${-pi} ${-pi/4}" />
    </joint>

    <gazebo reference="robot_mount"> </gazebo>
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg simulation_controllers)</parameters>
            <ros>
                <namespace>$(arg ros_namespace)</namespace>
            </ros>
        </plugin>
    </gazebo>
    <xacro:ur_ros2_control name="$(arg name)" tf_prefix="$(arg tf_prefix)"
        transmission_hw_interface="$(arg transmission_hw_interface)" />
</robot>